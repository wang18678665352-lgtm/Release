# ====================== 编译产物 ======================
# 可执行文件
*.exe
# 批处理脚本（启动.bat这类）
*.bat
# 目标文件
*.o
*.obj
# 静态库/动态库
*.a
*.lib
*.so
*.dll
# 编译日志
*.log

# ====================== 文件夹忽略 ======================
# mingw64 编译工具链/临时目录
mingw64/
# 编译输出目录（比如 build/、Release/、Debug/，如果你的项目有）
# build/
# Release/
# Debug/

# ====================== 系统/IDE 临时文件 ======================
# Windows 系统文件
Thumbs.db
.DS_Store
# VS Code 配置（如果不想提交本地配置就加上）
.vscode/
.vs/
# Git 临时文件
.git/

# ====================== 项目临时文件 ======================
# 测试输入/输出文件（test_input.txt这类，不需要提交就加上）
test_*.txt
# 数据目录（如果data是运行生成的，不是源码，就加上）
# data/